{
  "name": "@zakkster/lite-pick",
  "author": "Zahary Shinikchiev <shinikchiev@yahoo.com>",
  "version": "0.8.0",
  "description": "Zero-dependency, zero-GC load-balancing selection kernel: one hot pick() -> endpoint index over a fixed pool, 0 B/op steady-state. A pure selector (consumes health/circuit state, never a proxy) for the in-process hop, complementary to AWS NLB/ALB. Tree-shakeable ESM roster: RoundRobin, SmoothWRR, P2C, LeastConn, SED, NQ, PeakEWMA (latency-aware peak-EWMA), and ConsistentHash (Maglev sticky/affinity routing, minimal disruption); the /pool subpath adds dispatch/settle counters + failover and a duck-typed query-cache fetcher.",
  "type": "module",
  "main": "./Pick.js",
  "module": "./Pick.js",
  "types": "./Pick.d.ts",
  "exports": {
    ".": {
      "types": "./Pick.d.ts",
      "node": "./Pick.js",
      "import": "./Pick.js",
      "default": "./Pick.js"
    },
    "./pool": {
      "types": "./Pool.d.ts",
      "node": "./Pool.js",
      "import": "./Pool.js",
      "default": "./Pool.js"
    }
  },
  "files": [
    "Pick.js",
    "Pick.d.ts",
    "Pool.js",
    "Pool.d.ts",
    "llms.txt",
    "README.md",
    "RECIPES.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:types": "tsc -p test/types/tsconfig.json",
    "torture": "node --expose-gc test/torture.mjs",
    "witness": "node test/witness.mjs",
    "balance": "node test/balance.mjs",
    "fuzz": "node test/fuzz.mjs",
    "test:perf": "node --expose-gc --max-semi-space-size=4 --test test/perf/PerfGate.test.mjs",
    "bench": "node benchmark/Matrix.mjs",
    "bench:gc": "node --expose-gc benchmark/GcBlastRadius.mjs",
    "bench:fairness": "node benchmark/Fairness.mjs",
    "bench:disruption": "node benchmark/Disruption.mjs",
    "bench:report": "node benchmark/Matrix.mjs && node --expose-gc benchmark/Report.mjs",
    "bench:verify": "node benchmark/Report.mjs --verify",
    "soak": "node --expose-gc benchmark/Soak.mjs",
    "demo": "node demo/fanout.mjs",
    "verify": "npm test && npm run test:types && npm run torture && npm run witness && npm run balance && npm run fuzz && npm run test:perf"
  },
  "keywords": [
